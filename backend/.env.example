# ==============================================================================
# ResolvDesk Backend Environment Variables
# Copy this file to .env and configure the values for your local environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
APP_NAME=ResolvDesk
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------------------------
# 2. Relational Database (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# For local dev without Postgres, you can use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
# For production or Neon PostgreSQL:
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-hostname>/resolvdesk?ssl=require

# ------------------------------------------------------------------------------
# 3. Authentication & Better Auth / JWKS
# ------------------------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
# Public key / JWKS for JWT signature verification:
JWKS_URL=http://localhost:3000/api/auth/jwks
JWT_ALGORITHM=RS256
JWT_AUDIENCE=resolvdesk-api
JWT_ISSUER=http://localhost:3000

# Set to false in staging/production:
DEV_AUTH_BYPASS=true

# ------------------------------------------------------------------------------
# 4. Vector Database (Qdrant)
# ------------------------------------------------------------------------------
# For local in-memory testing:
# QDRANT_URL=:memory:
# QDRANT_API_KEY=
# For Qdrant Cloud:
QDRANT_URL=https://<your-cluster-id>.eu-central-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION_NAME=resolvdesk_documents

# ------------------------------------------------------------------------------
# 5. Embedding Provider
# ------------------------------------------------------------------------------
# Option A: Cohere v3 (Recommended)
EMBEDDING_API_BASE=https://api.cohere.com/v2
EMBEDDING_API_KEY=your-cohere-api-key
EMBEDDING_MODEL_NAME=embed-english-v3.0
EMBEDDING_DIMENSION=1024

# Option B: OpenAI (Alternative)
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=your-openai-api-key
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# 5.1 LLM Provider (OpenAI-compatible)
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=mistral-small-latest

# ------------------------------------------------------------------------------
# 6. Document Ingestion Constraints & Limits
# ------------------------------------------------------------------------------
MAX_DOCUMENT_SIZE_BYTES=10485760   # 10 MB
MAX_DOCUMENTS_PER_ORG=50
MAX_RAW_TEXT_CHARS=100000
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# ------------------------------------------------------------------------------
# 7. CORS & Widget
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
WIDGET_KEY_PREFIX=rd_live_
WIDGET_GRACE_PERIOD_HOURS=24
