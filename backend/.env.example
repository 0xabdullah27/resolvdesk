# ==============================================================================
# ResolvDesk Backend Environment Variables
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Relational Database (Required)
# ------------------------------------------------------------------------------
# In production, use Neon / PostgreSQL. Local SQLite fallback: sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql://<username>:<password>@<neon-hostname>/resolvdesk?sslmode=require

# ------------------------------------------------------------------------------
# 2. Better Auth URL (Required)
# ------------------------------------------------------------------------------
# Points to your deployment root (e.g. https://resolvdesk.online or http://localhost:3000)
# JWKS_URL and AUTH_ISSUER are automatically derived from this URL!
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Vector Database - Qdrant (Required in Production)
# ------------------------------------------------------------------------------
# In production, use Qdrant Cloud cluster. Local testing fallback: :memory:
QDRANT_URL=https://<your-cluster-id>.eu-central-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key

# ------------------------------------------------------------------------------
# 4. AI Provider Key (Required in Production)
# ------------------------------------------------------------------------------
# Providing OPENAI_API_KEY automatically powers both Embeddings (text-embedding-3-small)
# and Chat Completion (gpt-4o-mini).
OPENAI_API_KEY=sk-...

# ------------------------------------------------------------------------------
# 5. Optional Overrides & Custom Providers (Leave blank to use defaults)
# ------------------------------------------------------------------------------
# ENVIRONMENT=production
# DEBUG=false
#
# Custom Embeddings (e.g. Cohere):
# EMBEDDING_API_BASE=https://api.cohere.com/v2
# EMBEDDING_API_KEY=your-cohere-key
# EMBEDDING_MODEL_NAME=embed-english-v3.0
# EMBEDDING_DIMENSION=1024
#
# Custom LLM (e.g. Mistral / Groq):
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=your-mistral-key
# LLM_MODEL=mistral-small-latest
